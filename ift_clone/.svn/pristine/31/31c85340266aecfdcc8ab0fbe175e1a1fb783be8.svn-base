#ifndef IMAGO_AUXILIARYWINDOW_H
#define IMAGO_AUXILIARYWINDOW_H

#include <QWidget>
#include <QGraphicsView>

#include "segmqtapi.h"

class AnnotationArea;

namespace Ui {
class AuxiliaryWindow;
}

class AuxiliaryWindow : public QWidget
{
    Q_OBJECT;

public:
    explicit AuxiliaryWindow(QWidget *parent = nullptr);
    ~AuxiliaryWindow() override;

    void scaleAndTranslate(double factor, QPointF pos);
    void setImage(  QImage &image);

    void connectScrollBar(AnnotationArea *area);

private:
    Ui::AuxiliaryWindow *ui;
    QGraphicsScene *scene;

    AnnotationArea *connectedArea;
    QImage image;

//    void disconnectScrollBar(); // TODO check it is not really needed to disconnect

private slots:
    void saveView();

protected:
    void closeEvent(QCloseEvent *event) override;
};


#endif //IMAGO_AUXILIARYWINDOW_H
