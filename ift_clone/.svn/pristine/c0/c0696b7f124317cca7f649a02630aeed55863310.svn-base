#ifndef IMAGO_METRICLEARNENGINE_H
#define IMAGO_METRICLEARNENGINE_H


#include <QObject>

#include <Eigen/Core>

#include "metriclearn/largemargin.h"
#include "metriclearn/neighborcompanalysis.h"

class MetricLearnEngine : public QObject
{
    Q_OBJECT;

public:
    explicit MetricLearnEngine();
    ~MetricLearnEngine();

    void setParam(MatrixXd *data, VectorXi *label, int out_dim, int k_targets, int iterations, double learn_rate);
    // TODO add kernel param
    void setMethod(  QString &str) { method = str; modified = true; }
    void setModified(bool value) { modified = value; }

    void reset();
    void train();
    MatrixXd transform(MatrixXd &input);

signals:
    void trained();

private:
    QString method = "Kernel Large Margin";
    bool executed = false;
    bool modified = false;

    segm::LargeMargin *lm = nullptr;
    segm::NeighborCompAnalysis *nca = nullptr;

    MatrixXd *data;
    VectorXi *label;
    MatrixXd gram;
    MatrixXd L;

    int out_dim;
    int k_targets;
    int iterations;
    double learn_rate;

};


#endif //IMAGO_METRICLEARNENGINE_H
