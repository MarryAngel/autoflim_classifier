cmake_minimum_required(VERSION 3.1.0)

project(imago)

set(CMAKE_CXX_STANDARD 14)
set(CMAKE_C_STANDARD 11)

set(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} -fsanitize=address")
set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} -O3")

# Find includes in corresponding build directories
set(CMAKE_INCLUDE_CURRENT_DIR ON)
# Instruct CMake to run moc automatically when needed
set(CMAKE_AUTOMOC ON)
# Create code from a list of Qt designer ui files
set(CMAKE_AUTOUIC ON)

#find_package(Qt5 CONFIG REQUIRED COMPONENTS Core Gui Widgets Charts)
find_package(Qt5 5.12 CONFIG REQUIRED COMPONENTS Core Gui Widgets) # temporally remove charts
find_package(segm CONFIG REQUIRED)
# OpenMP because of segm
find_package(OpenMP)

include_directories(external)

#add_subdirectory(src/maxflow)
#add_subdirectory(src/powerwatershed)

set(SRCS
        src/annotationarea.cpp
        src/auxiliarywindow.cpp
        src/helper.cpp
        src/mainwindow.cpp
        src/markers.cpp
        src/metriclearnengine.cpp
        src/metriclearnwindow.cpp
        src/experimentmanager.cpp
        src/segmqtapi.cpp
#        src/pwqtapi.cpp
        )

set(qt_UI
        src/auxiliarywindow.ui
        src/mainwindow.ui
        src/metriclearnwindow.ui)

QT5_WRAP_UI(qt_UI_H ${qt_UI})

add_executable(imago WIN32 main ${SRCS} ${qt_UI_H})

target_include_directories(imago PRIVATE src)

#target_link_libraries(imago Qt5::Core Qt5::Gui Qt5::Widgets Qt5::Charts)
target_link_libraries(imago Qt5::Core Qt5::Gui Qt5::Widgets) # Temporally removed charts
target_link_libraries(imago segm)
# target_link_libraries(imago maxflow)
# target_link_libraries(imago powerwatershed)

# OpenMP because of segm
if (OPENMP_FOUND)
    target_link_libraries(imago OpenMP::OpenMP_CXX)
endif()

