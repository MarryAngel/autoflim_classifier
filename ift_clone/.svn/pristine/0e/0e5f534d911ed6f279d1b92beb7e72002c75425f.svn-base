#include "iftqtapi.h"

QImage iftImageToQImage(  iftImage *input, bool increment)
{
    QImage output(input->xsize, input->ysize, QImage::Format_Indexed8);
    for (int i = 0; i < input->xsize; i++) {
        for (int j = 0; j < input->ysize; j++) {
            iftVoxel v = {.x = i, .y = j, .z = 0};
            int val = input->val[iftGetVoxelIndex(input, v)] + increment;
            if (val < 0) throw std::invalid_argument("Input values must be non-negative");
            output.setPixel(i, j, static_cast<uint>(val));
        }
    }

    return output;
}


QImage iftMImageToQImage(  iftMImage *input)
{
    if (input->m != 3) throw std::invalid_argument("Input must have 3 bands");

    QImage output(input->xsize, input->ysize, QImage::Format_RGB32);
    for (int i = 0; i < input->xsize; i++) {
        for (int j = 0; j < input->zsize; j++) {
            iftVoxel v = {.x = i, .y = j, .z = 0};
            int idx = iftGetVoxelIndex(input, v);
            QColor color(static_cast<int>(input->band[0].val[idx]),
                         static_cast<int>(input->band[1].val[idx]),
                         static_cast<int>(input->band[2].val[idx]));
            output.setPixel(i, j, color.rgb());
        }
    }

    return output;
}


iftImage *QImageToiftImage(  QImage &input, bool decrement)
{
    if (input.format() != QImage::Format_Indexed8)
        throw std::invalid_argument("Input must be an indexed 8bits image");

    iftImage *output = iftCreateImage(input.width(), input.height(), 1);
    for (int i = 0; i < input.width(); i++) {
        for (int j = 0; input.height(); j++) {
            iftVoxel v = {.x = i, .y = j, .z = 0};
            uint val = input.pixel(i, j);
            output->val[iftGetVoxelIndex(output, v)] = val - decrement;
        }
    }

    return output;
}


iftMImage *QImageToiftMImage(  QImage &input)
{
    iftMImage *output = iftCreateMImage(input.width(), input.height(), 1, 3);
    for (int i = 0; i < input.width(); i++) {
        for (int j = 0; j < input.height(); j++) {
            iftVoxel v = {.x = i, .y = j, .z = 0};
            int idx = iftGetVoxelIndex(output, v);
            QColor color(input.pixel(i, j));
            output->band[0].val[idx] = color.red();
            output->band[1].val[idx] = color.green();
            output->band[2].val[idx] = color.blue();
        }
    }

    return output;
}


iftLabeledSet *QImageToiftLabaledSet(  QImage &input)
{
    if (input.format() != QImage::Format_Indexed8)
        throw std::invalid_argument("Input must be an indexed 8bits image");

    iftLabeledSet *output = NULL;
    for (int i = 0; i < input.width(); i++) {
        for (int j = 0; j < input.height(); j++) {
            int val = input.pixel(i, j);
            if (val > 0) {
                iftInsertLabeledSet(&output, i * input.width() + j, val - 1);
            }
        }
    }

    return output;
}