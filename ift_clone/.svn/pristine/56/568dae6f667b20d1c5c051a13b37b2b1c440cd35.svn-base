#include "segmqtapi.h"

#include <QHash>

#include <Eigen/Dense>


QColor heatmap(float value) {
    QColor c;
    c.setHslF((1.0 - value) * 0.66666666, 1.0, 0.5);
    return c;
}


QImage segmImageToQImage(  segm::Image<int> &input, QVector<QRgb> &markerColors, bool increment)
{
    QImage output(input.getWidth(), input.getHeight(), QImage::Format_Indexed8);
    output.setColorTable(markerColors);
    for (int i = 0; i < output.width(); i++) {
        for (int j = 0; j < output.height(); j++) {
            int val = input(i, j) + increment;
            if (val < 0) throw std::invalid_argument("Input values must be non-negative");
            output.setPixel(i, j, static_cast<uint>(val));
        }
    }

    return output;
}


QImage segmImageToQImage(  segm::Image<int> &input)
{
    if (input.getBands() != 1)
        throw std::invalid_argument("Number of image bands must be 1");

    QHash<int, QColor> hash;
    QImage output(input.getWidth(), input.getHeight(), QImage::Format_RGB32);

    for (int i = 0; i < output.width(); i++) {
        for (int j = 0; j < output.height(); j++) {
            int root = input(i, j);
            if (!hash.contains(root)) {
                int r = qRound(((float) random() / RAND_MAX) * 255);
                int g = qRound(((float) random() / RAND_MAX) * 255);
                int b = qRound(((float) random() / RAND_MAX) * 255);
                QColor c(r, g, b);
                hash[root] = c;
            }
            output.setPixelColor(i, j, hash[root]);
        }
    }
    return output;
}


QImage segmImageToQImage(  segm::Image<float> &input, int normalization)
{
    if (input.getBands() == 3) {
        QImage output(input.getWidth(), input.getHeight(), QImage::Format_RGB32);
        for (int i = 0; i < output.width(); i++) {
            for (int j = 0; j < output.height(); j++) {
                float *band = input.getFeats(i, j);
                QColor color(qRound(band[0]), qRound(band[1]), qRound(band[2]));
                output.setPixel(i, j, color.rgb());
            }
        }
        return output;
    } else if (input.getBands() == 1) {
        QImage output(input.getWidth(), input.getHeight(), QImage::Format_Grayscale8);
        float min = std::numeric_limits<float>::max();
        float max = std::numeric_limits<float>::min();

        for (int i = 0; i < output.width(); i++) {
            for (int j = 0; j < output.height(); j++) {
                float val = input(i, j);
                if (val < min) min = val;
                if (val > max) max = val;
            }
        }

        for (int i = 0; i < output.width(); i++) {
            for (int j = 0; j < output.height(); j++) {
                int val = qRound((input(i, j) - min) / max * normalization);
                output.setPixel(i, j, qRgb(val, val, val));
            }
        }

        return output;
    } else {
        throw std::invalid_argument("Number of image bands must be 3 or 1");
    }
}


QImage segmImageToHeatMap(  segm::Image<int> &input)
{
    if (input.getBands() != 1)
        throw std::invalid_argument("Number of image bands must be 1");

    int minimum = input.min();
    float maximum = input.max() - minimum;

    QImage output(input.getWidth(), input.getHeight(), QImage::Format_RGB32);
    for (int i = 0; i < output.width(); i++) {
        for (int j = 0; j < output.height(); j++) {
            QColor c = heatmap((input(i, j) - minimum) / maximum);
            output.setPixelColor(i, j, c);
        }
    }
    return output;
}


segm::Image<int> QImageToSegmImage(  QImage &input, bool decrement)
{
    if (input.format() != QImage::Format_Indexed8)
        throw std::invalid_argument("Input must be an indexed 8bits image");

    segm::Image<int> output(input.width(), input.height());

    for (int i = 0; i < input.width(); i++) {
        for (int j = 0; j < input.height(); j++) {
            output(i, j) = input.pixelIndex(i, j) - decrement;
        }
    }

    return output;
}


segm::Image<float> QImageToSegmImage(  QImage &input)
{
    segm::Image<float> output(input.width(), input.height(), 3);
    for (int i = 0; i < input.width(); i++) {
        for (int j = 0; j < input.height(); j++) {
            QColor color(input.pixel(i, j));
            output(i, j, 0) = color.red();
            output(i, j, 1) = color.green();
            output(i, j, 2) = color.blue();
        }
    }

    return output;
}


segm::Image<int> propagateLabel(  segm::Image<int> &label,   segm::Image<int> &sup)
{
    if (label.getWidth() != sup.getWidth() || label.getHeight() != sup.getHeight())
        throw std::invalid_argument("Label and sup image must have the same dimensions");

    segm::Image<int> output(label.getWidth(), label.getHeight());

    Eigen::MatrixXi count = Eigen::MatrixXi::Constant(sup.max() + 1, label.max() + 1, 0);
    
    for (int p = 0; p < sup.getSize(); p++) {
        count(sup(p), label(p)) += 1;
    }

    std::vector<int> max((unsigned long)count.rows(), 0);
    for (int i = 0; i < count.rows(); i++) {
        for (int j = 1; j < count.cols(); j++) {
            if (count(i, j) > count(i, max[i]))
                max[i] = j;
        }
    }

    for (int i = 0; i < output.getSize(); i++) {
        output(i) = max[sup(i)];
    }

    return output;
}


void QImageSetAlpha(  segm::Image<int> &contour, QImage &image)
{
    if (contour.getWidth() != image.width() || contour.getHeight() != image.height())
        throw std::invalid_argument("Image and contour must have the same dimensions");

    for (int y = 0; y < image.height(); y++) {
        for (int x = 0; x < image.width(); x++) {
            if (!contour(x, y)) {
                image.setPixel(x, y, Qt::black);
            }
        }
    }
}
