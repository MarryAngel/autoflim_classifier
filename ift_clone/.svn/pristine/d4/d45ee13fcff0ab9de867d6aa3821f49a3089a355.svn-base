#ifndef IMAGO_MARKERS_H
#define IMAGO_MARKERS_H

#include <QWidget>
#include <vector>

class Markers : public QObject
{
    Q_OBJECT
public:
    explicit Markers(QObject *parent = nullptr);

    void addMarker();
    void setColor(  QRgb new_color) { colors[current_marker] = new_color; }
    QRgb getColor()   { return colors[current_marker]; }
    QRgb getColor(int idx)   { return colors[idx]; }
    QVector<QRgb> &getColors() { return colors; }
    bool setCurrent(int idx);
    int getCurrent()   { return current_marker; }
    int getSize()   { return colors.size(); }

signals:

public slots:

private:
    QVector<QRgb> colors;
    int current_marker;
};

#endif // IMAGO_MARKERS_H
