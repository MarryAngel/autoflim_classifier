#include "mainwindow.h"
#include "ui_mainwindow.h"
#include "auxiliarywindow.h"

#include <QCloseEvent>
#include <QColorDialog>
#include <QFileDialog>
#include <QMessageBox>

#include <iostream>

MainWindow::MainWindow(  QStringList &args, QWidget *parent) :
    QMainWindow(parent),
    ui(new Ui::MainWindow)
{
    undoStack = new QUndoStack(this);
    showMaximized();
    ui->setupUi(this);
    updateMarker();
    ui->mrkIDSpinBox->setFocus();
    current_dir = QDir::currentPath();

    if (args.size() == 4)
    {   // experiment mode
        ui->annotGView->openImage(args[1]);
        ui->annotGView->openMarkers(args[2]);
        ui->annotGView->setCurrentAlgorithm(args[3]);
        ui->segAlgoCombBox->setCurrentText(args[3]);
        ui->annotGView->startExp();
    }
}

MainWindow::~MainWindow()
{
    delete undoStack;
    delete ui;
}

bool MainWindow::maybeSave()
{
    if (ui->annotGView->isModified()) {
       QMessageBox::StandardButton ret;
       ret = QMessageBox::warning(this, tr("Imago"),
                          tr("The image has been modified.\n"
                             "Do you want to save your changes?"),
                          QMessageBox::Save | QMessageBox::Discard
                          | QMessageBox::Cancel);
        if (ret == QMessageBox::Save) {
            return (ui->annotGView->saveGrayLabel() && saveMarkers()) ;
        } else if (ret == QMessageBox::Cancel) {
            return false;
        }
    }
    return true;
}

void MainWindow::closeEvent(QCloseEvent *event)
{
    if (maybeSave()) {
        event->accept();
    } else {
        event->ignore();
    }
}

void MainWindow::loadImage()
{
    if (maybeSave()) {
        QString fileName = QFileDialog::getOpenFileName(this, tr("Open File"), current_dir);
        if (!fileName.isEmpty()) {
            current_dir = getDirectory(fileName);
            ui->annotGView->openImage(fileName);
        }
    }
}

