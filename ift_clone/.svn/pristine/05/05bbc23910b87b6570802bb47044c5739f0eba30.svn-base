#include "auxiliarywindow.h"
#include "ui_auxiliarywindow.h"
#include "annotationarea.h"
#include "helper.h"

#include <QScrollBar>

AuxiliaryWindow::AuxiliaryWindow(QWidget *parent) :
    QWidget(parent, Qt::Tool),
    ui(new Ui::AuxiliaryWindow)
{
    ui->setupUi(this);
    scene = new QGraphicsScene(ui->auxGView);
    ui->auxGView->setScene(scene);
    show();
}


AuxiliaryWindow::~AuxiliaryWindow()
{
    delete ui;
}

void AuxiliaryWindow::scaleAndTranslate(double factor, QPointF pos)
{
    ui->auxGView->scale(factor, factor);
    ui->auxGView->translate(pos.x(), pos.y());
}

void AuxiliaryWindow::setImage(  QImage &_image)
{
    image = _image;
    scene->addPixmap(QPixmap::fromImage(image));
    ui->auxGView->fitInView(image.rect(), Qt::KeepAspectRatio);
    update();
}

void AuxiliaryWindow::connectScrollBar(AnnotationArea *area)
{
    connectedArea = area;
    QGraphicsView *auxView = ui->auxGView;

    connect(connectedArea->horizontalScrollBar(), &QScrollBar::valueChanged,
            auxView->horizontalScrollBar(), &QScrollBar::setValue);
    connect(connectedArea->verticalScrollBar(), &QScrollBar::valueChanged,
            auxView->verticalScrollBar(), &QScrollBar::setValue);

    connect(auxView->horizontalScrollBar(), &QScrollBar::valueChanged,
            connectedArea->horizontalScrollBar(), &QScrollBar::setValue);
    connect(auxView->verticalScrollBar(), &QScrollBar::valueChanged,
            connectedArea->verticalScrollBar(), &QScrollBar::setValue);
}


void AuxiliaryWindow::saveView()
{
    saveImage(this, image);
}

void AuxiliaryWindow::closeEvent(QCloseEvent *event)
{
    connectedArea->popAuxWindow(this);
}

