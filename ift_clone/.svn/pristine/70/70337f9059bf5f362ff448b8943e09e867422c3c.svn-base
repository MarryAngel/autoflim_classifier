  {
   "cell_type": "code",
   "execution_count": 157,
   "metadata": {},
   "outputs": [],
   "source": [
    "latent_mnt_file    = '../input_samples/basep_mnts/1-104930526.mnt'\n",
    "reference_mnt_file = '../input_samples/basep_mnts/1-61386113.mnt' \n",
    "\n",
    "def read_mnt(mnt_file):\n",
    "    with open(mnt_file, 'r') as fp:\n",
    "            mnts = fp.readlines()[2:]\n",
    "    mnts = [tuple([int(i) for i in item.strip().split(' ')[:2]]) for item in mnts]\n",
    "    return mnts\n",
    "\n",
    "latent_mnts    = read_mnt(latent_mnt_file)\n",
    "reference_mnts = read_mnt(reference_mnt_file)\n",
    "reference_mnts = reference_mnts[:len(latent_mnts)]\n",
    "# reference_mnts = [(item,(random.randint(0,512), random.randint(0,512))) for item in  reference_mnts]\n",
    "# reference_mnts = [tuple([item]) for item in  reference_mnts]\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 130,
   "metadata": {},
   "outputs": [],
   "source": [
    "from itertools import product\n",
    "def cartesian_product(arr1, arr2):\n",
    "    return list(product(arr1, arr2))\n",
    "\n",
    "r = []\n",
    "for item in reference_mnts:\n",
    "    r += cartesian_product(latent_mnts, item)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 158,
   "metadata": {},
   "outputs": [],
   "source": [
    "homologous_points = list(zip(latent_mnts, reference_mnts))\n",
    "homologous_pairs  = [comb for comb in combinations(homologous_points, 2)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 159,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "latent mnts:  30\n",
      "reference mnts:  30\n",
      "homologous_pairs:  435\n"
     ]
    }
   ],
   "source": [
    "print('latent mnts: ', len(latent_mnts))\n",
    "print('reference mnts: ', len(reference_mnts))\n",
    "print('homologous_pairs: ', len(homologous_pairs))\n",
    "# print('homologous_points: ', homologous_points[:2])\n",
    "#print('homologous_pairs: ', homologous_pairs[:2])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 141,
   "metadata": {},
   "outputs": [],
   "source": [
    "teste = []\n",
    "for i in range(len(latent_mnts)):\n",
    "    for j in range(len(reference_mnts[i])):\n",
    "        teste.append((latent_mnts[i], reference_mnts[i][j]))"
   ]
  },
