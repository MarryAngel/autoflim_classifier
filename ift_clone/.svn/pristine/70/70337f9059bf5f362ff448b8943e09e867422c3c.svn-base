  {
   "cell_type": "code",
   "execution_count": 38,
   "metadata": {},
   "outputs": [],
   "source": [
    "iftImageA = ift.CreateImageFromNumPy(imgA, False)\n",
    "iftImageB = ift.CreateImageFromNumPy(imgB, False)\n",
    "mask = np.ones((imgA.shape), dtype = np.int32)\n",
    "iftMask = ift.CreateImageFromNumPy(mask, False)\n",
    "A = ift.Circular(3.5)\n",
    "iftbin = ift.BelowAdaptiveThreshold(iftImageA, None, A, 0.99, 1, 255)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "metadata": {},
   "outputs": [],
   "source": [
    "teste = iftbin.AsNumPy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "metadata": {},
   "outputs": [
